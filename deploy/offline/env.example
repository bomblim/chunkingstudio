# Chunking Studio 컨테이너 환경변수 — .env로 복사해 값을 채우세요.
# 이 파일의 값은 docker compose(env_file)로 컨테이너에 전달됩니다.

# ---------------------------------------------------------------- 연결
# 기존 Milvus 주소 (시드 시 'Milvus 로컬' 저장소에 사용, 이후에는 화면 '벡터 저장소'에서 변경)
CS_MILVUS_URI=http://milvus.internal:19530
# 브라우저에서 접속할 주소 (CORS 허용)
CS_CORS_ORIGINS=http://chunking-studio.internal:8000

# ---------------------------------------------------------------- 폐쇄망 정책
# false면 외부(상용) LLM·임베딩 API를 숨기고 호출을 차단
CS_ALLOW_EXTERNAL_LLM=false
# 개발용 샘플 Parser API (/api/dev/sample-parser) 노출 여부
CS_ENABLE_SAMPLE_PARSER=true
# 첫 실행 시 샘플 Parser·Mock 모델·기본 프롬프트·샘플 문서 등록
CS_SEED=true

# ---------------------------------------------------------------- 비밀값 (모델·Parser 등록 화면의 "환경변수" 칸과 이름을 맞춤)
# UPSTAGE_API_KEY=up_xxxxxxxx
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# COHERE_API_KEY=        # 상용 리랭크(Cohere) 예시용
# MILVUS_TOKEN=user:password

# 외부 시스템이 Studio API를 호출할 주소 — "API 안내" 화면의 curl 예시에 표시 (비우면 브라우저 접속 주소)
# CS_STUDIO_URL=http://studio.example.com:8000

# ---------------------------------------------------------------- 로그인
# 사용자가 하나도 없을 때 시작하면서 만들 첫 관리자 (비우면 첫 화면에서 "최초 관리자 만들기")
# CS_ADMIN_USERNAME=admin
# CS_ADMIN_PASSWORD=8자이상비밀번호
# 로그인 세션 유지 시간(시간, 사용 중에는 연장)
# CS_SESSION_HOURS=12
