# Milvus 오프라인 실행 설정 — .env로 복사해 필요한 값만 바꾸세요 (docker compose가 자동으로 읽음).

# 외부에 열 포트와 바인딩 주소
#   기본: 모든 인터페이스(0.0.0.0)에 19530(엔진), 9091(관리) 공개
#   같은 서버의 nginx로 TLS 종료할 때(nginx-milvus.conf):
#     MILVUS_BIND=127.0.0.1, MILVUS_PORT=29530        → nginx가 19530(TLS)으로 받아 29530으로 전달
#     MILVUS_HEALTH_BIND=127.0.0.1                     → 관리 화면도 nginx를 거쳐서만 접근
MILVUS_BIND=0.0.0.0
MILVUS_PORT=19530
MILVUS_HEALTH_BIND=0.0.0.0
MILVUS_HEALTH_PORT=9091

# Docker 네트워크 이름 (Chunking Studio 컨테이너를 같은 네트워크에 붙일 때 사용)
MILVUS_NETWORK=milvus

# Milvus 내부 저장소(MinIO) 계정 — 처음 실행하기 전에 바꾸세요. 데이터가 생긴 뒤 바꾸면 접속할 수 없습니다.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
