# Chunking Studio 백엔드 환경변수 예시
# 이 파일을 backend/.env로 복사해 값을 채우세요. (.env는 git에 커밋되지 않습니다)
# 서버 시작 시 자동으로 읽으며, 셸이나 OS에 이미 설정된 값이 우선합니다.
# 값을 바꾼 뒤에는 서버를 재시작하세요.

# ---------------------------------------------------------------- Studio 설정
# CS_DATA_DIR=./data
# CS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/chunking_studio
# 폐쇄망 모드: false면 외부(상용) LLM을 숨기고 호출을 차단
# CS_ALLOW_EXTERNAL_LLM=true
# CS_ENABLE_SAMPLE_PARSER=true
# CS_SEED=true
# Studio가 자기 자신(샘플 Parser)을 호출할 때 쓰는 내부 주소
# CS_PUBLIC_BASE_URL=http://127.0.0.1:8000
# 외부 시스템이 Studio API를 호출할 주소 — "API 안내" 화면의 curl 예시에 표시 (비우면 브라우저 접속 주소)
# CS_STUDIO_URL=http://studio.example.com:8000
# CS_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- LLM API 키
# 변수 이름은 모델 레지스트리의 "API 키 환경변수" 칸과 같아야 합니다.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# COHERE_API_KEY=        # 상용 리랭크(Cohere) 예시용

# ---------------------------------------------------------------- Parser 인증값
# 변수 이름은 Parser Registry의 "인증 값 환경변수" 칸과 같아야 합니다.
# 인증 헤더가 Authorization이고 값에 공백이 없으면(토큰만 넣으면) "Bearer "가 자동으로 붙습니다.
# PARSER_X_TOKEN=xxxxx

# Upstage 파서 (Parser Registry의 upstage-parser). 토큰만 넣으면 "Bearer "가 자동으로 붙습니다.
# UPSTAGE_API_KEY=up_xxxxxxxx

# ---------------------------------------------------------------- 로그인
# 사용자가 하나도 없을 때 시작하면서 만들 첫 관리자 (비우면 첫 화면에서 "최초 관리자 만들기")
# CS_ADMIN_USERNAME=admin
# CS_ADMIN_PASSWORD=8자이상비밀번호
# 로그인 세션 유지 시간(시간, 사용 중에는 연장)
# CS_SESSION_HOURS=12
